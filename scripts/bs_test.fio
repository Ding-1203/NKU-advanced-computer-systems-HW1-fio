rw=read
bs=16k
stonewall=1

[seq_read_bs_64k]
rw=read
bs=64k
stonewall=1

[seq_read_bs_256k]
rw=read
bs=256k
stonewall=1

[seq_read_bs_1m]
rw=read
bs=1M
stonewall=1

[rand_read_bs_4k]
rw=randread
bs=4k
stonewall=1

[rand_read_bs_16k]
rw=randread
bs=16k
stonewall=1

[rand_read_bs_64k]
rw=randread
bs=64k
