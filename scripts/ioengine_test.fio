[global]
filename=/home/ding/advanced-computer-systems/hw1-fio/fio_test_file
size=1G
runtime=20
time_based
bs=4k
numjobs=1
iodepth=1

[seq_read_psync]
rw=read
ioengine=psync
stonewall=1

[seq_read_libaio]
rw=read
ioengine=libaio
stonewall=1

[seq_read_io_uring]
rw=read
ioengine=io_uring
stonewall=1

[seq_read_mmap]
rw=read
ioengine=mmap
stonewall=1

[rand_read_psync]
rw=randread
ioengine=psync
stonewall=1

[rand_read_libaio]
rw=randread
ioengine=libaio
stonewall=1

[rand_read_io_uring]
rw=randread
ioengine=io_uring
stonewall=1

[rand_read_mmap]
rw=randread
ioengine=mmap
stonewall=1
